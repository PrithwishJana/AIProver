#!/usr/bin/env bash
# Launcher for aiprover.py: finds a Python >= 3.11 (tomllib) and follows symlinks, so the skill
# works when linked into ~/.agents/skills or ~/.claude/skills.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
for py in "${AIPROVER_PYTHON:-}" python3 python3.13 python3.12 python3.11; do
  [ -n "$py" ] || continue
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$py" "$HERE/aiprover.py" "$@"
  fi
done
echo "aiprover: needs Python >= 3.11 on PATH (or set AIPROVER_PYTHON)" >&2
exit 2
